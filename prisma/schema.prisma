generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PropertyType {
  SHORT_TERM // Appartamento al mare - affitti brevi (Booking/Airbnb)
  MONTHLY // Appartamento in affitto mensile
}

enum Platform {
  BOOKING
  AIRBNB
}

enum ExpenseCategory {
  MANUTENZIONE
  RIPARAZIONI
  CONDOMINIO_ORDINARIA
  CONDOMINIO_RISCALDAMENTO
  IMU
  LUCE
  ACQUA
  GAS
  INTERNET
  ALTRO
}

enum DocumentCategory {
  CONTRATTO
  FATTURA
  RICEVUTA
  FISCALE
  CONDOMINIALE
  MANUTENZIONE
  SCREENSHOT_PRENOTAZIONE
  ALTRO
}

// ---------------------------------------------------------------------------
// Core domain
// ---------------------------------------------------------------------------

model Property {
  id      String       @id @default(cuid())
  type    PropertyType
  name    String
  address String?

  // Monthly-rental specific fields
  tenantName    String?
  tenantPhone   String?
  monthlyRent   Decimal?  @db.Decimal(10, 2)
  contractStart DateTime?
  contractEnd   DateTime?
  deposit       Decimal?  @db.Decimal(10, 2)
  notes         String?

  // Short-term specific field
  cityTaxRate Decimal? @db.Decimal(10, 2) // tassa di soggiorno, per ospite a notte

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings        Booking[]
  monthlyPayments MonthlyPayment[]
  expenses        Expense[]
  documents       Document[]
  notesList       Note[]
  reminders       Reminder[]

  @@index([type])
}

model PlatformSetting {
  id                    String   @id @default(cuid())
  platform              Platform @unique
  commissionPercent     Decimal  @db.Decimal(5, 2)
  transactionFeePercent Decimal  @default(0) @db.Decimal(5, 2)
  vatPercent            Decimal  @default(22) @db.Decimal(5, 2)
  taxPercent            Decimal  @db.Decimal(5, 2)
  updatedAt             DateTime @updatedAt
}

model Booking {
  id       String   @id @default(cuid())
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  guestName String
  guests    Int      @default(1)
  platform  Platform

  checkIn  DateTime
  checkOut DateTime

  amountPaid         Decimal @db.Decimal(10, 2)
  platformCommission Decimal @default(0) @db.Decimal(10, 2)
  taxes              Decimal @default(0) @db.Decimal(10, 2)
  otherDeductions    Decimal @default(0) @db.Decimal(10, 2)
  cityTax            Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses  Expense[]
  documents Document[]

  @@index([propertyId])
  @@index([checkIn])
  @@index([checkOut])
  @@index([platform])
}

model MonthlyPayment {
  id       String   @id @default(cuid())
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  year  Int
  month Int // 1-12

  isPaid     Boolean   @default(false)
  paidDate   DateTime?
  amountDue  Decimal   @db.Decimal(10, 2)
  amountPaid Decimal?  @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, year, month])
  @@index([year, month])
}

model Expense {
  id       String   @id @default(cuid())
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId String?

  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime
  description String?
  notes       String?
  attachmentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([category])
  @@index([date])
}

model Document {
  id       String    @id @default(cuid())
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String?

  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String?

  category DocumentCategory
  fileName String
  fileUrl  String
  mimeType String?
  notes    String?

  uploadedAt DateTime @default(now())

  @@index([propertyId])
  @@index([bookingId])
  @@index([category])
}

model Note {
  id       String    @id @default(cuid())
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String?

  year  Int?
  month Int?

  content   String
  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([year, month])
}

model Reminder {
  id       String    @id @default(cuid())
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String?

  title       String
  description String?
  dueDate     DateTime?
  isDone      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dueDate])
}
