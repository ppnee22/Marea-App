# Database (Neon Postgres) — vedi guida deploy per come ottenerle
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — genera con: npx auth secret  (oppure: openssl rand -base64 32)
AUTH_SECRET=""

# Anthropic (Claude) — per lettura screenshot prenotazioni e assistente IA
ANTHROPIC_API_KEY=""

# Vercel Blob — per upload documenti/foto
BLOB_READ_WRITE_TOKEN=""

# Utente iniziale creato da `npm run db:seed`
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""
SEED_USER_NAME="Admin"
